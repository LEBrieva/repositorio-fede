---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'BC Consultora | Consultoría Financiera y de Procesos para Empresas',
  description = 'Business Case Consultora. Consultoría financiera y de procesos para empresas que quieren crecer con orden. Acompañamos a pymes y empresas en Buenos Aires.',
  lang = 'es',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://bcconsultora.com.ar';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = `${siteUrl}/images/logos/logo-oscuro.png`;
const altLang = lang === 'es' ? 'en' : 'es';
const altUrl = lang === 'es' ? `${siteUrl}/en/` : `${siteUrl}/`;
const ogLocale = lang === 'es' ? 'es_AR' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_AR';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Business Case Consultora",
  "alternateName": "BC Consultora",
  "description": lang === 'es'
    ? "Consultoría financiera y de procesos para empresas que quieren crecer con orden. Acompañamos a pymes y empresas en Buenos Aires."
    : "Financial and process consulting for companies that want to grow with structure. We help SMEs and businesses in Buenos Aires.",
  "url": siteUrl,
  "logo": ogImage,
  "telephone": "+5491144381857",
  "email": "administracion@bcconsultora.com.ar",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Buenos Aires",
    "addressCountry": "AR"
  },
  "founder": {
    "@type": "Person",
    "name": "Federico Cuadra",
    "jobTitle": "Contador Público (UBA)"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Argentina"
  },
  "serviceType": [
    "Accounting",
    "Tax Advisory",
    "Financial Consulting",
    "Payroll Administration",
    "Project Management"
  ],
  "openingHours": "Mo-Fr 09:00-18:00",
  "priceRange": "$$",
  "inLanguage": [lang]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0f1a23" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:site_name" content="BC Consultora - Business Case" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Fonts -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      Saltar al contenido
    </a>
    <slot />

    <script>
      // Scroll reveal animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
