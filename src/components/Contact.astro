---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="contact" class="reveal py-20 lg:py-28 bg-background-alt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary mb-4">
        {t.contact.sectionTitle}
      </h2>
      <div class="w-16 h-1 bg-primary-light mx-auto mb-6 rounded-full"></div>
      <p class="text-text-light text-lg max-w-2xl mx-auto">
        {t.contact.sectionSubtitle}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-primary-light/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-primary">Email</p>
            <a href={`mailto:${t.contact.info.email}`} class="text-text-light hover:text-primary-light transition-colors">
              {t.contact.info.email}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-primary-light/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-primary">{locale === 'en' ? 'Phone' : 'Teléfono'}</p>
            <a href={`tel:${t.contact.info.phone.replace(/\s/g, '')}`} class="text-text-light hover:text-primary-light transition-colors">
              {t.contact.info.phone}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-primary-light/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-primary">{locale === 'en' ? 'Location' : 'Ubicación'}</p>
            <a href="https://maps.app.goo.gl/AXnnfwzukfVhuqdv9" target="_blank" rel="noopener noreferrer" class="text-text-light hover:text-primary-light transition-colors">
              {t.contact.info.address}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-primary-light/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-primary">{locale === 'en' ? 'Hours' : 'Horario'}</p>
            <p class="text-text-light">{t.contact.info.schedule}</p>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex gap-4 pt-4">
          <a href="https://www.linkedin.com/company/business-case-consultores" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-primary hover:bg-primary-light text-white rounded-xl flex items-center justify-center transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href={`https://wa.me/${t.contact.info.phone.replace(/[\s\-\+]/g, '')}`} target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-primary hover:bg-primary-light text-white rounded-xl flex items-center justify-center transition-colors" aria-label="WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a href="https://share.google/wVFIktbFEe5xh8NAl" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-primary hover:bg-primary-light text-white rounded-xl flex items-center justify-center transition-colors" aria-label="Google">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/bc.finanzas" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-primary hover:bg-primary-light text-white rounded-xl flex items-center justify-center transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>

        <!-- Map -->
        <div class="mt-6 rounded-xl overflow-hidden border border-primary/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3271.5!2d-58.5!3d-34.86!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcd6fe5f89927f%3A0xbd0676aca459c817!2sAmaneceres%20Office!5e0!3m2!1ses-419!2sar!4v1"
            width="100%"
            height="180"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a href="https://maps.app.goo.gl/AXnnfwzukfVhuqdv9" target="_blank" rel="noopener noreferrer" class="block text-center text-sm text-primary-light hover:text-primary py-2 bg-background-alt transition-colors">
            {locale === 'en' ? 'Open in Google Maps' : 'Abrir en Google Maps'}
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-background-alt rounded-2xl p-8">
        <form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" class="space-y-6">
          <div class="hidden">
            <input name="bot-field" />
          </div>
          <div>
            <label for="name" class="block text-sm font-medium text-primary mb-2">
              {t.contact.form.name}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 bg-background border border-primary/10 rounded-xl text-text focus:outline-none focus:border-primary-light focus:ring-1 focus:ring-primary-light transition-colors"
              required
              aria-required="true"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-primary mb-2">
              {t.contact.form.email}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full px-4 py-3 bg-background border border-primary/10 rounded-xl text-text focus:outline-none focus:border-primary-light focus:ring-1 focus:ring-primary-light transition-colors"
              required
              aria-required="true"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-primary mb-2">
              {t.contact.form.message}
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full px-4 py-3 bg-background border border-primary/10 rounded-xl text-text focus:outline-none focus:border-primary-light focus:ring-1 focus:ring-primary-light transition-colors resize-none"
              required
              aria-required="true"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-primary-light hover:bg-primary-dark text-white font-semibold py-4 rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-primary-light/25 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {t.contact.form.send}
          </button>
        </form>
      </div>
    </div>
  </div>

  <div id="contact-toast" class="fixed bottom-6 right-6 z-50 hidden">
    <div id="toast-content" class="px-6 py-4 rounded-xl shadow-lg text-white font-medium text-sm max-w-sm">
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('form[name="contact"]');
  const submitBtn = form?.querySelector('button[type="submit"]');
  const toast = document.getElementById('contact-toast');
  const toastContent = document.getElementById('toast-content');
  const originalBtnText = submitBtn?.textContent || '';

  function showToast(message, success = true) {
    if (!toast || !toastContent) return;
    toastContent.textContent = message;
    toastContent.className = `px-6 py-4 rounded-xl shadow-lg text-white font-medium text-sm max-w-sm ${success ? 'bg-green-600' : 'bg-red-600'}`;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 4000);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || submitBtn.disabled) return;

    const formData = new FormData(form);
    submitBtn.disabled = true;

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData).toString(),
      });

      if (res.ok) {
        showToast('¡Mensaje enviado correctamente!', true);
        form.reset();
        let seconds = 30;
        submitBtn.textContent = `Enviado (${seconds}s)`;
        const interval = setInterval(() => {
          seconds--;
          submitBtn.textContent = `Enviado (${seconds}s)`;
          if (seconds <= 0) {
            clearInterval(interval);
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
          }
        }, 1000);
      } else {
        showToast('Error al enviar. Intentá de nuevo.', false);
        submitBtn.disabled = false;
      }
    } catch {
      showToast('Error de conexión. Intentá de nuevo.', false);
      submitBtn.disabled = false;
    }
  });
</script>
